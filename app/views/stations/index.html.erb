<div id="toast-container"></div>

<div id='mapContainer'>
  <button class="fancy_button closest-station-btn" data-controller="geolocation" data-action="click->geolocation#locate">Find closest station</button>
	<div id='stationsMap'>
		<div class='mapText'>
			Click for <span class='live'>live</span> train times
		</div>
		<div id='linkContainer'>
			<ul id='stationsList'>
				<%= render partial: 'stations/frames/station', collection: @stations %>
			</ul>
		</div>
	</div>
</div>

